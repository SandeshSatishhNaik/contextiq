# Copy to .env and fill in. Never commit .env.
# mock = offline PayPal-shaped responses; sandbox = PayPal sandbox REST API
PAYPAL_ENV=mock
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID from your sandbox app (needs a public URL, e.g. ngrok -> /api/webhooks/paypal)
PAYPAL_WEBHOOK_ID=
DEFAULT_CURRENCY=USD
PUBLIC_BASE_URL=http://localhost:8000

# Optional GenAI reasoning layer (used only for wording, policy reading and unclear questions)
# Groq has a free tier: create a key at console.groq.com
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL_SMALL=llama-3.1-8b-instant
GROQ_MODEL_LARGE=llama-3.3-70b-versatile
# ...or Claude (paid per use): LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL_SMALL=claude-haiku-5-5
LLM_MODEL_LARGE=claude-sonnet-5-5

# Voice (Siri Shortcut / phone assistant) — any long random string; sent as X-Voice-Token
VOICE_TOKEN= 

# Security gateway limits
STEP_UP_AMOUNT=500
NEW_PAYEE_STEP_UP_AMOUNT=200
SERVER_SECRET=change-me-to-a-long-random-string
# DATABASE_URL=postgresql+psycopg://user:pass@localhost/contextiq

# Optional investing market data (free key at alphavantage.co)
ALPHAVANTAGE_API_KEY=