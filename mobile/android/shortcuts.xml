<?xml version="1.0" encoding="utf-8"?>
<!-- Android App Actions (Google Assistant / Gemini) capability.
     NOT BUILT OR TESTED here (needs Android Studio). Place in res/xml/shortcuts.xml and reference it from
     AndroidManifest.xml: <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
     "Hey Google, ask ContextIQ where my refund is" opens AskActivity with the spoken text. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <capability android:name="actions.intent.GET_THING">
        <intent android:action="android.intent.action.VIEW"
                android:targetPackage="com.contextiq.app"
                android:targetClass="com.contextiq.app.AskActivity">
            <parameter android:name="thing.name" android:key="question" />
        </intent>
    </capability>
</shortcuts>
